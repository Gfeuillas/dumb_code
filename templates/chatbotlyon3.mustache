<div id="chatbotlyon3-bubble" class="chatbotlyon3-bubble"></div>
<div id="chatbotlyon3-container" class="chatbotlyon3-container" data-apikey="{{apikey}}">
  <div class="chatbotlyon3-header">
   <button class="chatbotlyon3-btn" id="chatbotlyon3-minimize" aria-label="Minimize chatbot">_</button>
   <button class="chatbotlyon3-btn" id="chatbotlyon3-maximize" aria-label="Maximize chatbot">[]</button>
   <button class="chatbotlyon3-btn" id="chatbotlyon3-close" aria-label="Close chatbot">X</button>
 </div>
 <div>
    <p>Bonjour, je suis Max !</p>
    <form>
        <label for="chatbotlyon3-question">Votre question...</label>
        <input type="text" id="chatbotlyon3-question" name="question">
        <button type="submit" id="chatbotlyon3-send">Envoyer</button>
    </form>
 </div>
</div>
